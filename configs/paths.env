# Shared asset roots for relation_hallucination.
# Shell: set -a && source configs/paths.env && set +a
# Override any variable before sourcing.

# Code checkout (each worktree has its own). Usually inferred, not required.
# RH_ROOT=/data/storage22t/lht/works/relation_hallucination

# RelSim images + 100k json + LLaVA/CLIP weights
